---
import { Image } from 'astro:assets';
import type { ProjectCardProps } from '@/utils/types/project';
type Props = ProjectCardProps;

const { title, content, imgMeta, reverse, demoLink, sourceLink } = Astro.props;
---

<div class={`min-h-[500px] flex items-center ${!reverse && 'bg-cyan-50'}`}>
  <div class={`mx-auto hero max-w-5xl`}>
    <div
      class={`hero-content w-full flex-col md:flex-row ${!!reverse && ' md:flex-row-reverse'}  gap-20`}
    >
      {
        imgMeta && (
          <Image src={imgMeta} class='w-full max-w-lg rounded-lg shadow-2xl' alt='Project image' />
        )
      }

      <div class='flex-grow'>
        <h1 class='text-3xl font-bold'>{title}</h1>
        <p class='py-6 text-xl'>{content}</p>
        {
          !!demoLink && (
            <a class='btn btn-primary' href={demoLink} target='_blank'>
              Demo
              <svg
                xmlns='http://www.w3.org/2000/svg'
                fill='none'
                viewBox='0 0 24 24'
                stroke-width='1.5'
                stroke='currentColor'
                class='size-4'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244'
                />
              </svg>
            </a>
          )
        }

        {
          !!sourceLink && (
            <a class='btn btn-primary' href={sourceLink} target='_blank'>
              Source
              <svg
                class='w-5 h-5 fill-white'
                focusable='false'
                aria-hidden='true'
                viewBox='0 0 24 24'
                data-testid='GitHubIcon'
              >
                <path d='M12 1.27a11 11 0 00-3.48 21.46c.55.09.73-.28.73-.55v-1.84c-3.03.64-3.67-1.46-3.67-1.46-.55-1.29-1.28-1.65-1.28-1.65-.92-.65.1-.65.1-.65 1.1 0 1.73 1.1 1.73 1.1.92 1.65 2.57 1.2 3.21.92a2 2 0 01.64-1.47c-2.47-.27-5.04-1.19-5.04-5.5 0-1.1.46-2.1 1.2-2.84a3.76 3.76 0 010-2.93s.91-.28 3.11 1.1c1.8-.49 3.7-.49 5.5 0 2.1-1.38 3.02-1.1 3.02-1.1a3.76 3.76 0 010 2.93c.83.74 1.2 1.74 1.2 2.94 0 4.21-2.57 5.13-5.04 5.4.45.37.82.92.82 2.02v3.03c0 .27.1.64.73.55A11 11 0 0012 1.27' />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>
</div>
